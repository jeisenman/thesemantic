SEMANTIC_API_URL=http://127.0.0.1:5056
MLFLOW_TRACKING_URI=http://127.0.0.1:5055
MLFLOW_EXPERIMENT_NAME=ra/the-semantic
# Optional trusted lineage service. Leave unset to use the local default.
# SEMANTIC_LINEAGE_URL=http://127.0.0.1:7420
# Optional approved typed graph export. Use an absolute file path; this takes
# precedence over the HTTP source. Unset by default; bad configured files fail.
# SEMANTIC_LINEAGE_SNAPSHOT=/absolute/path/to/graph.json
# Optional export directory. Leave unset to retain the var/zendesk-snapshot link.
# SEMANTIC_ZENDESK_SNAPSHOT=
# CODEX_HOME and CODEX_BINARY are local paths; never place tokens here.
