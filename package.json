{
  "name": "the-semantic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/runtime"
  ],
  "scripts": {
    "build:runtime": "npm run build --workspace @the-semantic/runtime",
    "build:desktop": "npm run build --workspace @the-semantic/desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test:setup": "node --test scripts/setup.test.mjs scripts/start.test.mjs",
    "api": "node scripts/start.mjs api",
    "desktop": "node scripts/start.mjs desktop",
    "researcher": "node scripts/start.mjs researcher",
    "setup": "node scripts/setup.mjs"
  }
}
